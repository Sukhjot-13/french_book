  "patches": [
    {
      "entity_key": "apercevoir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to glimpse"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Non-pronominal « apercevoir » means to catch sight of or glimpse; « s'apercevoir de » means to notice or realize."
          ]
        }
      ]
    },
    {
      "entity_key": "appartenir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Appartenir » is followed by « à » to identify the owner or group: « ce livre appartient à Léa »."
          ]
        }
      ]
    },
    {
      "entity_key": "appeler",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "The stem has a double l before a silent ending, as in « j'appelle »; « s'appeler » is used to state someone's name."
          ]
        }
      ]
    },
    {
      "entity_key": "apporter",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "bring"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Apporter » normally refers to bringing an object; « amener » is generally used for bringing a person or animal."
          ]
        }
      ]
    },
    {
      "entity_key": "apprendre",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to teach"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
