      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Aspirer à » is followed by a noun or infinitive and means to aspire to; without « à », « aspirer » can instead mean to inhale or vacuum."
          ]
        }
      ]
    },
    {
