      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to happen"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Besides meaning to arrive, « arriver » can mean to happen; « arriver à + infinitif » means to manage or succeed in doing something."
          ]
        }
      ]
    },
    {
      "entity_key": "arrêter",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to stop"
          ]
        },
        {
          "operation": "add_unique",
          "field": "search_terms",
          "values": [
            "arrest",
            "stop"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
