    {"entity_key": "la dernière semaine", "operations": [{"operation": "set_if_empty", "field": "collocation_strength", "value": "common"}, {"operation": "add_unique", "field": "usage_notes", "values": ["La dernière semaine désigne la semaine finale d’une période ou d’une série; la semaine dernière désigne la semaine précédant le moment présent."]}]},
