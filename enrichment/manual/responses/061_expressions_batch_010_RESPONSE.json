    {"entity_key": "la semaine suivante", "operations": [{"operation": "set_if_empty", "field": "collocation_strength", "value": "common"}, {"operation": "add_unique", "field": "usage_notes", "values": ["La semaine suivante is relative to a previously mentioned past or future reference point, unlike la semaine prochaine, which is relative to now."]}]},
