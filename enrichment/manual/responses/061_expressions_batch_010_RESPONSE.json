    {"entity_key": "le lendemain", "operations": [{"operation": "set_if_empty", "field": "collocation_strength", "value": "common"}, {"operation": "add_unique", "field": "usage_notes", "values": ["Le lendemain is relative to a reference day already established in the discourse, rather than necessarily meaning tomorrow."]}]},
