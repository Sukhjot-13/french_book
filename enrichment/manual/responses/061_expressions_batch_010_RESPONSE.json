    {"entity_key": "manquer de + nom", "operations": [{"operation": "add_unique", "field": "usage_notes", "values": ["Manquer de + nom expresses an insufficiency or absence of the thing named: manquer de temps, de patience or de ressources."]}]},
    {"entity_key": "manquer à + personne", "operations": [{"operation": "add_unique", "field": "usage_notes", "values": ["The person or thing that is missed is the subject, while the person feeling the absence follows à: tu me manques means I miss you."]}]},
