{
  "batch_id": "050_verbs_batch_024",
  "collection": "verbs",
  "patches": [
    {
      "entity_key": "valoir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Valoir » is used for value or merit; the impersonal expression « il vaut mieux + infinitif » means it is better to do something."
          ]
        }
      ]
    },
    {
      "entity_key": "venir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Venir » uses « être » in compound tenses; « venir de + infinitif » expresses the recent past."
          ]
        }
      ]
    },
    {
      "entity_key": "viser",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to aim at",
            "to target"
          ]
        },
        {
          "operation": "add_unique",
          "field": "search_terms",
          "values": [
            "aim",
            "target"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Viser » can take a direct object for targeting something, and « viser à + infinitif » means to aim to achieve an objective."
          ]
        }
      ]
    },
    {
      "entity_key": "visiter",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Use « visiter » primarily for a place or site; for visiting a person, standard French usually uses « rendre visite à »."
          ]
        }
      ]
    },
    {
      "entity_key": "voler",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Voler » has two distinct common senses, to fly and to steal; in the theft sense, the stolen item is a direct object and the victim may be introduced by « à »."
          ]
        }
      ]
    },
    {
      "entity_key": "voter",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Use « voter pour » or « voter contre » a candidate or proposal; transitive « voter une loi » means to pass a law by vote."
          ]
        }
      ]
    },
    {
      "entity_key": "vouloir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "The conditional « je voudrais » is a polite way to express a request or wish, softer than present-tense « je veux »."
          ]
        }
      ]
    },
    {
      "entity_key": "échouer",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to fail",
            "to run aground"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Échouer à un examen » means to fail an exam; for a plan, « échouer » means to fail, and for a vessel it can mean to run aground."
          ]
        }
      ]
    },
    {
      "entity_key": "écosser",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to shell"
          ]
        },
        {
          "operation": "add_unique",
          "field": "search_terms",
          "values": [
            "shell peas",
            "shell beans"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Écosser » means to remove peas, beans, or similar seeds from their pods."
          ]
        }
      ]
    },
    {
      "entity_key": "écouter",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Unlike English “listen to,” « écouter » takes a direct object without a preposition: « écouter la radio »."
          ]
        }
      ]
    }
  ],
  "uncertain_suggestions": [],
  "batch_summary": "Added missing senses and notes on auxiliaries, idioms, voting, visiting, and direct-object usage."
}