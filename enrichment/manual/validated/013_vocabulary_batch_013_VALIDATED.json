        "canonical_form": "librairie",
        "part_of_speech": "noun"
      },
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Despite its resemblance to English “library,” « librairie » means a bookshop; a library is « une bibliothèque »."
          ]
        }
      ]
    },
