      "entity_key": "ne...personne",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Personne replaces pas and normally follows the past participle in a compound tense; as subject, personne ne precedes the verb."
          ]
        }
      ]
