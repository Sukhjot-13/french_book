    {
      "entity_key": "ne pas croire que + subjonctif",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Negated croire que generally takes the subjunctive because the proposition is not asserted as true; the indicative can occur when the speaker treats it as factual."
          ]
        }
      ]
    },
    {
      "entity_key": "ne pas penser que + subjonctif",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Negated penser que normally favors the subjunctive because the subordinate proposition is placed in doubt."
          ]
        }
      ]
    },
