    {
      "entity_key": "retourner",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Intransitive « retourner » means to go back and generally takes « être »; transitive use means to turn something over and takes « avoir »."
          ]
        }
      ]
    },
    {
      "entity_key": "revenir",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Revenir » means to come back, uses « être » in compound tenses, and often takes « de » for the place of return."
          ]
        }
      ]
    },
