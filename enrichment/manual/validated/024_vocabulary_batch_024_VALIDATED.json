      },
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Vingt » takes an s when multiplied and final, as in « quatre-vingts », but loses it before another number, as in « quatre-vingt-un »."
          ]
        }
      ]
