{
  "batch_id": "067_expressions_batch_016",
  "collection": "expressions",
  "patches": [
    {
      "entity_key": "se rendre compte de",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Takes de before a noun or pronoun; when followed by a complete clause, use se rendre compte que."
          ]
        }
      ]
    },
    {
      "entity_key": "se rendre compte que",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Introduces a complete clause stating the fact that has been realized; no de is used before que."
          ]
        }
      ]
    },
    {
      "entity_key": "se servir de",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Se servir de means to use something as a tool or resource and requires de before the object used."
          ]
        }
      ]
    },
    {
      "entity_key": "se souvenir de",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Se souvenir requires de, unlike se rappeler, which normally takes a direct object."
          ]
        }
      ]
    },
    {
      "entity_key": "se tromper de",
      "operations": [
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "to choose the wrong",
            "to get the wrong"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Se tromper de identifies the category in which the wrong choice was made: se tromper de numéro, de route, or de personne."
          ]
        }
      ]
    },
    {
      "entity_key": "se téléphoner",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Téléphoner à quelqu’un makes the reciprocal pronoun indirect, so the past participle téléphoné normally remains invariable."
          ]
        }
      ]
    },
    {
      "entity_key": "se voir contraint de + infinitive",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Formal construction meaning that circumstances force the subject to act; contraint agrees with the subject."
          ]
        },
        {
          "operation": "set_if_empty",
          "field": "register",
          "value": "formal"
        }
      ]
    },
    {
      "entity_key": "si seulement",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "With the imperfect, expresses a wish about the present; with the pluperfect, expresses regret about an unrealized past event."
          ]
        }
      ]
    },
    {
      "entity_key": "souhaiter que + subjonctif",
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "When the wished-for action has an explicit subject introduced by que, the dependent verb is in the subjunctive."
          ]
        }
      ]
    },
    {
      "entity_key": "sous prétexte que",
      "operations": [
        {
          "operation": "set_if_empty",
          "field": "collocation_strength",
          "value": "common"
        },
        {
          "operation": "add_unique",
          "field": "english",
          "values": [
            "on the pretext that"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "Introduces the stated justification, often implying that the speaker considers it questionable or insincere."
          ]
        }
      ]
    },
    {
      "entity_key": "souvent",
      "operations": [
        {
          "operation": "set_if_empty",
          "field": "collocation_strength",
          "value": "common"
        }
      ]
    },
    {
