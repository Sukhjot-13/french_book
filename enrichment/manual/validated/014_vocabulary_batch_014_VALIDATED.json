          "values": [
            "mutton"
          ]
        },
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
            "« Mouton » can refer to the animal or to mutton; « brebis » specifically denotes an adult female sheep."
          ]
        }
      ]
    },
    {
      "entity_key": {
        "canonical_form": "médicament",
        "part_of_speech": "noun"
      },
      "operations": [
        {
          "operation": "add_unique",
          "field": "usage_notes",
          "values": [
