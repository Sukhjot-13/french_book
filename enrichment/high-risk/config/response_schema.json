{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "High-Risk AI Response Schema",
  "type": "object",
  "required": [
    "batch_id",
    "collection",
    "contract_version",
    "baseline_hash",
    "source_allowlist_version",
    "patches",
    "no_proposals",
    "batch_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{3}_[a-z_]+_batch_[0-9]{3}$"
    },
    "collection": {
      "type": "string",
      "enum": ["verbs"]
    },
    "contract_version": {
      "type": "string"
    },
    "baseline_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_allowlist_version": {
      "type": "string"
    },
    "batch_summary": {
      "type": "string"
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_key",
          "field",
          "operation",
          "precondition",
          "evidence",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "entity_key": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "enum": ["conjugations"]
          },
          "operation": {
            "type": "string",
            "enum": ["set_if_missing_complete"]
          },
          "precondition": {
            "type": "object",
            "required": ["field_state"],
            "additionalProperties": false,
            "properties": {
              "field_state": {
                "type": "string",
                "enum": ["EMPTY", "MISSING"]
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": ["source_id", "source_type", "reference_notes"],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              },
              "reference_notes": {
                "type": "string"
              }
            }
          },
          "value": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tense",
                "mood",
                "forms",
                "stems",
                "endings",
                "formation_note",
                "irregularities",
                "notes",
                "sources"
              ],
              "additionalProperties": false,
              "properties": {
                "tense": { "type": "string" },
                "mood": { "type": ["string", "null"] },
                "forms": {
                  "type": "object",
                  "required": [
                    "je",
                    "tu",
                    "il_elle_on",
                    "nous",
                    "vous",
                    "ils_elles",
                    "imperative_tu",
                    "imperative_nous",
                    "imperative_vous",
                    "impersonal_form"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "je": { "type": ["string", "null"] },
                    "tu": { "type": ["string", "null"] },
                    "il_elle_on": { "type": ["string", "null"] },
                    "nous": { "type": ["string", "null"] },
                    "vous": { "type": ["string", "null"] },
                    "ils_elles": { "type": ["string", "null"] },
                    "imperative_tu": { "type": ["string", "null"] },
                    "imperative_nous": { "type": ["string", "null"] },
                    "imperative_vous": { "type": ["string", "null"] },
                    "impersonal_form": { "type": ["string", "null"] }
                  }
                },
                "stems": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tense", "persons", "stem", "note"],
                    "additionalProperties": false,
                    "properties": {
                      "tense": { "type": ["string", "null"] },
                      "persons": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "stem": { "type": "string" },
                      "note": { "type": ["string", "null"] }
                    }
                  }
                },
                "endings": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "formation_note": { "type": ["string", "null"] },
                "irregularities": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "notes": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "no_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_key", "reason", "details"],
        "additionalProperties": false,
        "properties": {
          "entity_key": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "SOURCE_NOT_FOUND",
              "CONFLICTING_SOURCES",
              "PARTIAL_EXISTING_DATA",
              "UNSUPPORTED_VERB_TYPE",
              "DEFECTIVE_UNCERTAIN",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  }
}
