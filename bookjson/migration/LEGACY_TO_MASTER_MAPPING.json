{
  "version": "1.0.0",
  "description": "Explicit deterministic field-by-field and value-level mapping from LEGACY_COMBINED_SCHEMA.json to MASTER_SCHEMA.json.",
  "principles": {
    "zero_ai_inference": "All mappings are deterministic, auditable, and rule-based without AI or external linguistic invention.",
    "no_semantic_coercion": "Never semantically coerce enum values where meanings differ (e.g. invariable != variable). Exact equivalents normalize cleanly (être -> etre); non-matching classifications are preserved in source_classifications while canonical fields receive null, unknown, or other as appropriate.",
    "value_level_coverage": "Every populated legacy leaf value is accounted for as DIRECTLY_MAPPED, TRANSFORMED, MERGED, DEDUPLICATED, MOVED_TO_PROVENANCE, MOVED_TO_SOURCE_CLASSIFICATIONS, MOVED_TO_UNRESOLVED, or CONFLICTED.",
    "natural_references": "All artificial IDs (e.g. verb_prendre, tense_present, rule_123) are resolved to natural keys (e.g. prendre, présent, rule_name) via global lookup indices."
  },
  "enum_transformations": {
    "auxiliary": {
      "être": {
        "target": "etre",
        "rationale": "Exact orthographic normalization to match MASTER_SCHEMA enum constraint without meaning change."
      },
      "avoir": {
        "target": "avoir",
        "rationale": "Direct match."
      },
      "both": {
        "target": "both",
        "rationale": "Direct match."
      },
      "none": {
        "target": "none",
        "rationale": "Direct match."
      },
      "unknown": {
        "target": "unknown",
        "rationale": "Direct match."
      }
    },
    "gender": {
      "invariable": {
        "target": null,
        "preserved_in": "source_classifications",
        "rationale": "Invariable means non-inflecting for gender; it does NOT mean variable. Preserved accurately in source_classifications; canonical gender set to null."
      },
      "masculine": {
        "target": "masculine",
        "rationale": "Direct match."
      },
      "feminine": {
        "target": "feminine",
        "rationale": "Direct match."
      },
      "common": {
        "target": "common",
        "rationale": "Direct match."
      },
      "variable": {
        "target": "variable",
        "rationale": "Direct match."
      },
      "none": {
        "target": "none",
        "rationale": "Direct match."
      },
      "unknown": {
        "target": "unknown",
        "rationale": "Direct match."
      }
    },
    "expression_type": {
      "construction": {
        "target": "construction",
        "rationale": "Direct match."
      },
      "verb_pattern": {
        "target": "verb_pattern",
        "rationale": "Direct match."
      },
      "collocation": {
        "target": "collocation",
        "rationale": "Direct match."
      },
      "fixed_expression": {
        "target": "fixed_expression",
        "rationale": "Direct match."
      },
      "idiom": {
        "target": "idiom",
        "rationale": "Direct match."
      },
      "sentence_starter": {
        "target": "sentence_starter",
        "rationale": "Direct match."
      },
      "conversation_phrase": {
        "target": "conversation_phrase",
        "rationale": "Direct match."
      },
      "connector": {
        "target": "connector",
        "rationale": "Direct match."
      },
      "functional_phrase": {
        "target": "functional_phrase",
        "rationale": "Direct match."
      },
      "formulaic_phrase": {
        "target": "formulaic_phrase",
        "rationale": "Direct match."
      },
      "time_expression": {
        "target": "time_expression",
        "rationale": "Direct match."
      },
      "quantity_expression": {
        "target": "quantity_expression",
        "rationale": "Direct match."
      },
      "comparison_structure": {
        "target": "comparison_structure",
        "rationale": "Direct match."
      },
      "subjunctive_trigger": {
        "target": "subjunctive_trigger",
        "rationale": "Direct match."
      },
      "conditional_trigger": {
        "target": "conditional_trigger",
        "rationale": "Direct match."
      },
      "negative_construction": {
        "target": "negative_construction",
        "rationale": "Direct match."
      },
      "question_construction": {
        "target": "question_construction",
        "rationale": "Direct match."
      },
      "impersonal_expression": {
        "target": "other",
        "preserved_in": "source_classifications",
        "rationale": "Classification preserved in source_classifications; canonical field set to other."
      },
      "location_expression": {
        "target": "other",
        "preserved_in": "source_classifications",
        "rationale": "Classification preserved in source_classifications; canonical field set to other."
      },
      "frequency_expression": {
        "target": "other",
        "preserved_in": "source_classifications",
        "rationale": "Classification preserved in source_classifications; canonical field set to other."
      },
      "conjunction": {
        "target": "connector",
        "preserved_in": "source_classifications",
        "rationale": "Preserved in source_classifications; mapped to connector in master schema."
      }
    },
    "variant_type": {
      "masculine": {
        "target": "masculine",
        "rationale": "Direct match."
      },
      "feminine": {
        "target": "feminine",
        "rationale": "Direct match."
      },
      "masculine_before_vowel": {
        "target": "masculine_before_vowel",
        "rationale": "Direct match."
      },
      "plural": {
        "target": "plural",
        "rationale": "Direct match."
      },
      "alternate_spelling": {
        "target": "alternate_spelling",
        "rationale": "Direct match."
      },
      "inflected_form": {
        "target": "inflected_form",
        "rationale": "Direct match."
      },
      "feminine_before_vowel": {
        "target": "other",
        "preserved_in": "notes",
        "rationale": "Preserved in notes; canonical variant_type set to other."
      }
    }
  },
  "field_mappings": {
