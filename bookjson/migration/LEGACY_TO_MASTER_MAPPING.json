        "action": "MOVED_TO_PROVENANCE"
      },
      "chapter.conjugations[]": {
        "master": "verbs[].conjugations",
        "action": "TRANSFORMED",
        "transformation": "Deep-merged under matching verb by (tense, mood). Person forms normalized by stripping redundant subject pronouns deterministically (e.g. j'étais -> étais, tu étais -> étais) while preserving full text in provenance. Merged with conflict tracking."
      },
      "chapter.verbs[].present_participle": {
        "master": "verbs[].present_participle",
        "action": "TRANSFORMED",
        "transformation": "Normalized to lexical participle without reflexive pronoun for pronominal verbs (se levant -> levant, s'écrivant -> écrivant); original text preserved in provenance."
      },
      "chapter.expressions[]": {
        "master": "expressions[]",
        "action": "MERGED",
        "transformation": "Deduplicated by canonical_form. All lists merged by unique union."
      },
      "chapter.vocabulary[]": {
        "master": "vocabulary[]",
        "action": "MERGED",
        "transformation": "Deduplicated by canonical_form + part_of_speech. Legacy article string deterministically classified into structured articles object (definite, indefinite, partitive, other). Senses extended to support subordinate gender, articles, and plural to preserve distinct homographic senses without artificial IDs."
      },
      "chapter.grammar_rules[]": {
        "master": "grammar_rules[]",
        "action": "MERGED",
        "transformation": "Deduplicated by rule_name."
      },
      "chapter.concepts[]": {
        "master": "concepts[]",
        "action": "MERGED",
        "transformation": "Deduplicated by concept name."
      },
      "chapter.examples[]": {
        "master": "examples[]",
        "action": "MERGED",
        "transformation": "Deduplicated by normalized French sentence. All cross-links unioned."
      },
      "chapter.exercises[]": {
        "master": "exercises[]",
        "action": "MERGED",
        "transformation": "Deduplicated by chapter_number + exercise_code. Merged with answer_key.json."
      },
      "chapter.exceptions_and_traps[]": {
        "master": "exceptions_and_traps[]",
        "action": "MERGED",
        "transformation": "Deduplicated by title + category."
      },
      "chapter.uncertain_candidates[]": {
        "master": "unresolved_items[]",
        "action": "MOVED_TO_UNRESOLVED"
      }
