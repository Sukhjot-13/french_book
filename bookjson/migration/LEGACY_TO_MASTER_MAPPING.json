        "action": "MOVED_TO_PROVENANCE"
      },
      "chapter.chapter.id": {
        "master": null,
        "action": "TRANSFORMED",
        "transformation": "Used to index chapter and sections; converted to integer chapter_number."
      },
      "chapter.chapter.chapter_number": {
        "master": "chapters[].chapter_number",
        "action": "DIRECTLY_MAPPED"
      },
      "chapter.chapter.chapter_title": {
        "master": "chapters[].chapter_title",
        "action": "DIRECTLY_MAPPED"
      },
      "chapter.chapter.source_pages": {
