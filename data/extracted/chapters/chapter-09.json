    {
      "id": "rule_futur_anterieur_formation_and_use",
      "type": "grammar_rule",
      "title": "The futur antérieur (future perfect)",
      "short_label": "futur antérieur",
      "grammar_category": "tense_formation",
      "concept_ids": [],
      "tense_ids": [
        "tense_futur_anterieur"
      ],
      "summary": "Future of auxiliary (aurai/serai) + past participle. Expresses an action that will be completed before another future action.",
      "explanation": "'Quand j'aurai fini mes études, je trouverai un travail' (When I have finished my studies, I will find a job).",
      "formation": {
        "steps": [
          "Conjugate avoir or être in futur simple",
          "Add past participle"
        ],
        "patterns": [
          "[SUBJECT] + aurai/serai + [PARTICIPE PASSÉ]"
        ],
        "endings": {}
      },
      "usage_conditions": [
        "Action completed before another future event"
      ],
