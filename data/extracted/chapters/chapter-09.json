    {
      "id": "rule_futur_after_temporal_conjunctions",
      "type": "grammar_rule",
      "title": "Use of future tenses after temporal conjunctions (quand, dès que, etc.)",
      "short_label": "Future after quand/dès que",
      "grammar_category": "syntax",
      "concept_ids": [],
      "tense_ids": [
        "tense_futur_simple",
        "tense_futur_anterieur"
      ],
      "summary": "French requires the FUTURE tense after quand, lorsque, dès que, aussitôt que, tant que when referring to future events, unlike English which uses present.",
      "explanation": "In English: 'When I arrive, I will call you' (present arrive). In French: 'Quand j'arriverai, je t'appellerai' (future arriverai).",
      "formation": null,
      "usage_conditions": [
        "Time clauses referring to the future"
      ],
      "trigger_words": [
        "quand",
        "lorsque",
        "dès que",
        "aussitôt que",
        "tant que"
      ],
      "signal_words": [],
      "exceptions": [],
      "restrictions": [],
      "notes": [],
      "common_mistakes": [
        {
          "wrong": "Quand j'arrive demain, je te verrai",
          "correct": "Quand j'arriverai demain, je te verrai",
          "explanation": "Use future tense after quand for future time."
        }
      ],
