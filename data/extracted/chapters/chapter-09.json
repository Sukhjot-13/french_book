  "grammar_rules": [
    {
      "id": "rule_futur_simple_formation_and_stems",
      "type": "grammar_rule",
      "title": "Formation of the futur simple and irregular stems",
      "short_label": "futur simple formation",
      "grammar_category": "tense_formation",
      "concept_ids": [],
      "tense_ids": [
        "tense_futur_simple"
      ],
      "summary": "Infinitive (or irregular future stem) + endings: -ai, -as, -a, -ons, -ez, -ont.",
      "explanation": "For regular -er and -ir verbs, use the full infinitive. For -re verbs, drop the final 'e'.\nKey irregular stems:\n- avoir -> aur-\n- être -> ser-\n- aller -> ir-\n- faire -> fer-\n- venir -> viendr-\n- pouvoir -> pourr-\n- vouloir -> voudr-\n- savoir -> saur-\n- devoir -> devr-\n- voir -> verr-\n- envoyer -> enverr-",
      "formation": {
        "steps": [
          "Take infinitive or irregular future stem",
          "Add endings: -ai, -as, -a, -ons, -ez, -ont"
        ],
        "patterns": [
          "infinitive/stem + -ai/-as/-a/-ons/-ez/-ont"
        ],
        "endings": {
          "je": "ai",
          "tu": "as",
          "il_elle_on": "a",
          "nous": "ons",
          "vous": "ez",
          "ils_elles": "ont"
        }
      },
      "usage_conditions": [
        "Future events, predictions, intentions"
      ],
      "trigger_words": [
        "demain",
        "l'année prochaine",
        "bientôt",
        "un jour"
      ],
      "signal_words": [],
      "exceptions": [],
      "restrictions": [],
      "notes": [
        "The future endings are derived from the present tense of avoir (-ai, -as, -a, -ons, -ez, -ont)."
      ],
      "common_mistakes": [
        {
          "wrong": "je parlerais (conditional ending)",
          "correct": "je parlerai (future ending -ai)",
          "explanation": "Future 1st person singular ends in -ai, conditional ends in -ais."
        }
      ],
