    {
      "id": "rule_relative_pronoun_dont_rules",
      "type": "grammar_rule",
      "title": "The relative pronoun dont (replacing de + noun)",
      "short_label": "dont",
      "grammar_category": "relative_pronouns",
      "concept_ids": [
        "concept_relative_pronouns"
      ],
      "tense_ids": [],
      "summary": "'Dont' replaces 'de + noun' (expressing of which, whose, about which).",
      "explanation": "Used whenever the verb, adjective, or noun in the relative clause takes 'de':\n- parler de -> 'Le film dont je parle'\n- avoir besoin de -> 'Ce dont j'ai besoin'\n- être fier de -> 'L'enfant dont il est fier'\n- possession (whose) -> 'L'auteur dont j'ai lu le livre'.",
      "formation": null,
      "usage_conditions": [
        "Relating verbs/expressions requiring 'de'"
      ],
      "trigger_words": [
        "dont"
      ],
      "signal_words": [],
      "exceptions": [],
      "restrictions": [],
      "notes": [
        "Do not repeat 'de' or possessive after dont: 'L'homme dont le fils est médecin' (not 'dont son fils')."
      ],
      "common_mistakes": [
        {
          "wrong": "L'homme dont son fils...",
          "correct": "L'homme dont le fils...",
          "explanation": "Use definite article, not possessive, with dont."
        }
      ],
