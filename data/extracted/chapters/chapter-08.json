  "grammar_rules": [
    {
      "id": "rule_imparfait_formation_rule",
      "type": "grammar_rule",
      "title": "Formation of the imparfait",
      "short_label": "imparfait formation",
      "grammar_category": "tense_formation",
      "concept_ids": [
        "concept_past_time"
      ],
      "tense_ids": [
        "tense_imparfait"
      ],
      "summary": "Take the 'nous' present stem and add: -ais, -ais, -ait, -ions, -iez, -aient. Only one exception: être (ét-).",
      "explanation": "Find the stem by dropping -ons from the present tense 'nous' form:\n- nous parlons -> parl- + ais/ais/ait/ions/iez/aient\n- nous finissons -> finiss- + ais/ais/ait/ions/iez/aient\n- nous vendons -> vend- + ais/ais/ait/ions/iez/aient\n- Exception: être uses stem 'ét-' (j'étais, tu étais, etc.).",
      "formation": {
        "steps": [
          "Conjugate verb in present with 'nous'",
          "Drop -ons to find the stem",
          "Add endings: -ais, -ais, -ait, -ions, -iez, -aient"
        ],
        "patterns": [
          "nous_stem + -ais/-ais/-ait/-ions/-iez/-aient"
        ],
        "endings": {
          "je": "ais",
          "tu": "ais",
          "il_elle_on": "ait",
          "nous": "ions",
          "vous": "iez",
          "ils_elles": "aient"
        }
      },
      "usage_conditions": [
        "Past descriptions",
        "Habits",
        "Ongoing background actions"
      ],
      "trigger_words": [
        "autrefois",
        "souvent",
        "tous les jours",
        "chaque été",
        "pendant que"
      ],
      "signal_words": [],
      "exceptions": [
        "être is the only irregular stem: ét-"
      ],
      "restrictions": [],
      "notes": [],
      "common_mistakes": [
        {
          "wrong": "j'étais (from infinitive stem)",
          "correct": "j'étais (ét- stem)",
          "explanation": "Only être is irregular in the imparfait."
        }
      ],
