  "grammar_rules": [
    {
      "id": "rule_verbs_with_varying_preposition_meanings",
      "type": "grammar_rule",
      "title": "Verbs with different prepositions carrying different meanings",
      "short_label": "Preposition meaning shifts",
      "grammar_category": "verb_government",
      "concept_ids": [
