    {
      "id": "rule_bags_adjectives_before_noun",
      "type": "grammar_rule",
      "title": "Placement of adjectives: the BAGS rule (Beauty, Age, Goodness, Size)",
      "short_label": "BAGS adjective placement",
      "grammar_category": "adjectives",
      "concept_ids": [
        "concept_adjective_agreement"
      ],
      "tense_ids": [],
      "summary": "Most adjectives follow the noun in French, except BAGS adjectives which precede the noun.",
      "explanation": "- Beauty: beau, joli\n- Age: jeune, vieux, nouveau\n- Goodness: bon, mauvais, meilleur, gentil\n- Size: grand, petit, gros, haut, long\nExample: 'une jolie maison', 'un vieux livre', 'une grande ville'.",
      "formation": null,
      "usage_conditions": [
        "Adjectives placed before noun"
      ],
      "trigger_words": [
        "beau",
        "joli",
        "jeune",
        "vieux",
        "nouveau",
        "bon",
        "mauvais",
        "grand",
        "petit"
      ],
      "signal_words": [],
      "exceptions": [],
      "restrictions": [],
      "notes": [
        "Some adjectives change meaning based on position: grand homme (great man) vs homme grand (tall man); pauvre homme (pitiful) vs homme pauvre (poor)."
      ],
      "common_mistakes": [
        {
          "wrong": "une voiture belle",
          "correct": "une belle voiture",
          "explanation": "BAGS adjectives precede the noun."
        }
      ],
