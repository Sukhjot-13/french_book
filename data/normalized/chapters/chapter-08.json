    {
      "id": "rule_imparfait_vs_passe_compose_master_contrast",
      "type": "grammar_rule",
      "title": "Imparfait versus passé composé",
      "short_label": "Imparfait vs Passé composé",
      "grammar_category": "tense_contrast",
      "concept_ids": [
        "concept_past_time"
      ],
      "tense_ids": [
        "tense_imparfait",
        "tense_passe_compose"
      ],
      "summary": "Passé composé = foreground, specific completed events, interruptions. Imparfait = background, descriptions, ongoing states, habitual actions.",
      "explanation": "Use Passé Composé for:\n1. Completed actions with definite beginning/end\n2. Specific number of times or time limits\n3. Chain of sequential events\n4. Interrupter action\n\nUse Imparfait for:\n1. Setting the scene / background description (weather, emotions, physical states)\n2. Repeated or habitual actions (used to / would)\n3. Ongoing action in progress when another event occurred ('was doing').",
      "formation": null,
      "usage_conditions": [
        "Past narrative storytelling"
      ],
      "trigger_words": [
        "quand",
        "pendant que",
        "tout à coup",
        "soudain",
        "chaque jour",
        "un jour"
      ],
      "signal_words": [],
      "exceptions": [],
      "restrictions": [],
      "notes": [
        "Certain verbs shift meaning between tenses: savoir (savait = knew facts; a su = found out), connaître (connaissait = knew; a connu = met for first time), vouloir (voulait = wanted; a voulu = tried / refused)."
      ],
      "common_mistakes": [
        {
          "wrong": "Il pleuvait quand je suis parti vs Il a plu quand je suis parti",
          "correct": "Il pleuvait (background) quand je suis parti (event)",
          "explanation": "Background weather uses imparfait."
        }
      ],
