    {
      "id": "rule_si_plus_imparfait_suggestions",
      "type": "grammar_rule",
      "title": "Suggestions and wishes with Si on + imparfait",
      "short_label": "Si on + imparfait",
      "grammar_category": "idiomatic_construction",
      "concept_ids": [
        "concept_past_time"
      ],
      "tense_ids": [
        "tense_imparfait"
      ],
      "summary": "Starting a sentence with 'Si on' + imparfait expresses a friendly suggestion ('How about...? / What if we...?').",
      "explanation": "'Si on allait au restaurant ce soir?' (How about going to a restaurant tonight? / What if we went to a restaurant tonight?).",
      "formation": {
        "steps": [
          "Start with 'Si on' (or 'Si nous')",
          "Follow with verb in imparfait",
          "End with question mark"
        ],
        "patterns": [
          "Si on + [VERBE À L'IMPARFAIT]?"
        ],
        "endings": {}
      },
      "usage_conditions": [
        "Making suggestions",
        "Proposing ideas to friends"
      ],
