  "grammar_rules": [
    {
      "id": "rule_plus_que_parfait_formation_rule",
      "type": "grammar_rule",
      "title": "Formation of the plus-que-parfait (pluperfect)",
      "short_label": "plus-que-parfait formation",
      "grammar_category": "tense_formation",
      "concept_ids": [
        "concept_past_time"
      ],
      "tense_ids": [
        "tense_plus_que_parfait"
      ],
      "summary": "Imparfait of auxiliary (avais/étais) + past participle.",
      "explanation": "Formed with the imparfait of avoir or être followed by the past participle: 'J'avais parlé', 'Elle était partie'. Agreement rules mirror the passé composé.",
      "formation": {
        "steps": [
          "Conjugate avoir/être in imparfait (avais, avais, avait, avions, aviez, avaient / étais, étais, était, étions, étiez, étaient)",
          "Add past participle"
        ],
        "patterns": [
          "[SUBJECT] + avais/étais + [PARTICIPE PASSÉ]"
        ],
        "endings": {}
      },
      "usage_conditions": [
        "Actions that took place prior to another past action"
      ],
      "trigger_words": [
        "déjà",
        "avant",
        "si seulement"
      ],
