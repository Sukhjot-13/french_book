    {
      "id": "rule_plus_que_parfait_usage_and_si_seulement",
      "type": "grammar_rule",
      "title": "Uses of the plus-que-parfait and Si seulement",
      "short_label": "plus-que-parfait uses",
      "grammar_category": "tense_usage",
      "concept_ids": [
        "concept_past_time"
      ],
      "tense_ids": [
        "tense_plus_que_parfait"
      ],
      "summary": "1. Prior past action. 2. Regret with 'Si seulement' (If only...). 3. Past conditional clause (Si + plus-que-parfait).",
      "explanation": "- Prior past: 'Il avait déjà mangé quand je suis arrivé' (He had already eaten when I arrived).\n- Regret: 'Si seulement j'avais su!' (If only I had known!).",
