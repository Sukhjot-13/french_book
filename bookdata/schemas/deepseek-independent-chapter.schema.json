        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        },
        "formation": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/stringArray"
        },
        "restrictions": {
          "$ref": "#/$defs/stringArray"
        },
        "conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "signal_words": {
          "$ref": "#/$defs/stringArray"
        },
        "exceptions": {
          "$ref": "#/$defs/stringArray"
        },
        "agreement_rules": {
          "$ref": "#/$defs/stringArray"
        },
        "word_order": {
          "type": [
            "string",
            "null"
          ]
        },
        "negative_form": {
          "type": [
            "string",
            "null"
          ]
        },
        "interrogative_form": {
          "type": [
            "string",
            "null"
          ]
        },
        "affirmative_form": {
          "type": [
            "string",
            "null"
          ]
        },
        "transformations": {
          "$ref": "#/$defs/stringArray"
        },
        "contrast_with_ids": {
          "$ref": "#/$defs/idArray"
        },
        "common_traps": {
          "$ref": "#/$defs/stringArray"
        },
        "tense_ids": {
          "$ref": "#/$defs/idArray"
        },
        "concept_ids": {
          "$ref": "#/$defs/idArray"
        },
        "example_ids": {
          "$ref": "#/$defs/idArray"
        },
        "expression_ids": {
          "$ref": "#/$defs/idArray"
        },
        "verb_ids": {
          "$ref": "#/$defs/idArray"
        },
        "study": {
          "$ref": "#/$defs/study"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "verbSense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english",
        "note"
      ],
      "properties": {
        "english": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "infinitive",
        "display_form",
        "english",
        "senses",
        "verb_group",
        "regularity",
        "pronominal",
        "transitivity",
        "auxiliary",
        "past_participle",
        "present_participle",
        "important_stems",
        "conjugation_ids",
        "expression_ids",
        "concept_ids",
        "aliases",
        "search_terms",
        "study",
        "origin",
        "attestations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^verb_[a-z0-9_]+$"
