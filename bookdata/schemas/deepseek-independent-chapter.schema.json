{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/deepseek-independent-chapter.schema.json",
  "title": "Independent French Grammar Chapter Extraction",
  "description": "Strict schema for one ground-zero chapter extraction. The source chapter controls content; this schema controls structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_mode",
    "chapter",
    "sections",
    "concepts",
    "grammar_rules",
    "verbs",
    "conjugations",
    "expressions",
    "vocabulary",
    "examples",
    "exercises",
    "exceptions_and_traps",
    "uncertain_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "extraction_mode": {
      "const": "independent_ground_zero"
    },
    "chapter": {
      "$ref": "#/$defs/chapterMeta"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "grammar_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grammarRule"
      }
    },
    "verbs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verb"
      }
    },
    "conjugations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conjugation"
      }
    },
    "expressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expression"
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vocabulary"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exercise"
      }
    },
    "exceptions_and_traps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exceptionTrap"
      }
    },
    "uncertain_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainCandidate"
      }
    }
  },
  "$defs": {
    "idArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "created_by",
        "derived_from_ids"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "book",
            "derived_from_book"
          ]
        },
        "created_by": {
          "type": "string",
          "enum": [
            "independent_extraction",
            "rule_expansion"
          ]
        },
        "derived_from_ids": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_number",
        "section_id",
        "section_title",
        "page_printed",
        "page_pdf",
        "context_type",
        "exercise_id",
        "question_number",
        "source_text"
      ],
      "properties": {
        "chapter_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_printed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_pdf": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "context_type": {
          "type": "string",
          "enum": [
            "explanation",
            "example",
            "exercise",
            "answer_key",
            "vocabulary",
            "table",
            "note",
            "dialogue",
            "caption",
            "warning",
            "contrast",
            "other",
            "exception"
          ]
        },
        "exercise_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_number": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_priority",
        "usefulness",
        "difficulty",
        "frequency_note"
      ],
      "properties": {
        "learning_priority": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "usefulness": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "difficulty": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "frequency_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "chapterMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter_number",
        "chapter_title",
        "source_pages",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^chapter_[0-9]{2}$"
        },
        "chapter_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "chapter_title": {
          "type": "string",
          "minLength": 1
        },
        "source_pages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "printed_start",
            "printed_end",
            "pdf_start",
            "pdf_end"
          ],
          "properties": {
            "printed_start": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "printed_end": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pdf_start": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pdf_end": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter_id",
        "title",
        "parent_section_id",
        "order",
        "page_printed_start",
        "page_printed_end",
        "page_pdf_start",
        "page_pdf_end",
        "concept_ids",
        "attestations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^section_[a-z0-9_]+$"
        },
        "chapter_id": {
          "type": "string",
          "pattern": "^chapter_[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "parent_section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "page_printed_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_printed_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_pdf_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_pdf_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "concept_ids": {
          "$ref": "#/$defs/idArray"
        },
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "aliases",
        "attestations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^concept_[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "grammarRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "rule_name",
        "summary",
        "explanation",
        "formation",
        "usage",
        "restrictions",
        "conditions",
        "signal_words",
        "exceptions",
        "agreement_rules",
        "word_order",
        "negative_form",
        "interrogative_form",
        "affirmative_form",
        "transformations",
        "contrast_with_ids",
        "common_traps",
        "tense_ids",
        "concept_ids",
        "example_ids",
        "expression_ids",
        "verb_ids",
        "study",
        "origin",
        "attestations"
      ],
