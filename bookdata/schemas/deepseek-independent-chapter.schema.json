          },
          "uniqueItems": true
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verbSense"
          }
        },
        "verb_group": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "1st_group",
            "2nd_group",
            "3rd_group",
            "defective",
            "impersonal",
            "unknown",
            null,
            "modal",
            "auxiliary"
          ]
        },
        "regularity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "regular",
            "irregular",
            "mixed",
            "unknown",
            null
          ]
        },
        "pronominal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transitivity": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "transitive",
              "intransitive",
              "ditransitive",
              "copular",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "auxiliary": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "avoir",
            "etre",
            "both",
            "none",
            "unknown",
            null
          ]
        },
        "past_participle": {
          "type": [
            "string",
            "null"
          ]
        },
        "present_participle": {
          "type": [
