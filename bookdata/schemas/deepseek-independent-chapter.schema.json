        "type": {
          "const": "verb"
        },
        "infinitive": {
          "type": "string",
          "minLength": 1
        },
        "display_form": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "array",
          "items": {
            "type": "string",
