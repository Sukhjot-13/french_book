        },
        "conjugation_ids": {
          "$ref": "#/$defs/idArray"
        },
        "expression_ids": {
          "$ref": "#/$defs/idArray"
        },
        "concept_ids": {
          "$ref": "#/$defs/idArray"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "search_terms": {
          "$ref": "#/$defs/stringArray"
        },
        "study": {
          "$ref": "#/$defs/study"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
